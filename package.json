{
  "name": "infernal-production-agent",
  "version": "0.1.0",
  "description": "Infernal League - Production Agent. Sbírá live data ze spectatované LoL hry, spojí je s post-game screenshotem, potvrdí a exportuje. Fáze 1A.",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "Infernal League",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:mock": "tsx watch src/index.ts --mock",
    "start": "tsx src/index.ts",
    "mock": "tsx src/index.ts --mock",
    "build": "tsc",
    "build:overlays": "node scripts/build-overlays.mjs",
    "build:all": "npm run build && npm run build:overlays",
    "serve": "node dist/index.js",
    "app": "electron .",
    "app:mock": "electron . --mock",
    "app:build": "npm run build:all && electron .",
    "pack:dir": "npm run build:all && electron-builder --win --dir",
    "dist:win": "npm run build:all && electron-builder --win",
    "release": "npm run build:all && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
